# 生产唯一配置入口：复制为 .env.production（已忽略，不提交）。
# 必填空值由 Compose 检查；密码含 $ 时用单引号包裹，勿 source 此文件。
# 国内 prod / ultrasend；海外 prod-overseas / ultrasend_overseas。
COMPOSE_PROJECT_NAME=shrimpsend
SPRING_PROFILES_ACTIVE=prod
MYSQL_DATABASE=ultrasend
MYSQL_USER=ultrasend
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 宿主机 HTTPS 反向代理连接以下端口；MySQL / 悟空管理 API 不对外暴露。
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=9000
WUKONGIM_WS_PORT=5200
WUKONGIM_IMAGE=registry.cn-shanghai.aliyuncs.com/wukongim/wukongim:v2
WUKONGIM_EXTERNAL_IP=127.0.0.1
WUKONGIM_MANAGER_TOKEN=
WUKONGIM_WS_PUBLIC_URL=wss://api.example.com/wkws
APP_PUBLIC_WEB_BASE_URL=https://example.com
APP_CORS_ALLOWED_ORIGINS=https://example.com

# 每个 JWT / IM 密钥分别生成：openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 授权指纹密钥：独立生成并长期保留，禁止随 JWT 轮换；已用码指纹不能删除。
DEVICE_LICENSE_SECRET=
# 独立数据库的发行前缀必须不同：国内 C / 国际 G / 本地 L。
DEVICE_LICENSE_NAMESPACE=C
DEVICE_LICENSE_CODE_TTL_SECONDS=600
DEVICE_LICENSE_REPLACEMENTS_PER_DAY=20
# Devices heartbeat every 15 seconds; retain at least two heartbeat intervals.
DEVICE_PRESENCE_LEASE_SECONDS=45
DEVICE_PRESENCE_SWEEP_MS=5000
# 每个加密密钥分别生成：openssl rand -base64 32
# 已有实例必须沿用旧密钥，否则历史密文 / S3 凭据无法解密。
APP_MESSAGES_ENCRYPTION_KEY_BASE64=
APP_USER_DATA_ENCRYPTION_KEK_BASE64=
APP_MESSAGES_ENCRYPTION_MIGRATE_ON_STARTUP=false
APP_USER_DATA_ENCRYPTION_MIGRATE_S3_ON_STARTUP=false
APP_USER_DATA_ENCRYPTION_MIGRATE_MESSAGES_ON_STARTUP=false
APP_USER_DATA_ENCRYPTION_MIGRATE_USER_DEK_ON_STARTUP=false

# 浏览器公开配置：修改后需 deploy.sh up 重建 Web。
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WUKONGIM_WS_URL=wss://api.example.com/wkws
NEXT_PUBLIC_WEB_BASE_URL=https://example.com
NEXT_PUBLIC_OPENPANEL_WEB_CLUSTER=cn
NEXT_PUBLIC_STRIPE_BILLING=live
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# 可选后端集成（未使用的保持空白）
HOSTED_S3_ENABLED=false
HOSTED_S3_REGION=auto
ALIPAY_RETURN_URL=https://example.com/settings/membership
ALIPAY_NOTIFY_URL=https://api.example.com/api/membership/alipay/notify
STRIPE_SUCCESS_URL=https://example.com/settings/membership?checkout=success
STRIPE_CANCEL_URL=https://example.com/settings/membership?checkout=cancel
STRIPE_BILLING_PORTAL_RETURN_URL=https://example.com/settings/membership
APP_ADMIN_EMAILS=admin@example.com
# 与 NEXT_PUBLIC_ADMIN_EMAILS 保持一致

# SendCloud 触发类 API_USER（发送设置中获取）；from 须为已验证发件地址
SENDCLOUD_API_USER=
SENDCLOUD_API_KEY=
SENDCLOUD_FROM=
SENDCLOUD_FROM_NAME=虾传

TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_SIGN_NAME=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

REVENUECAT_WEBHOOK_AUTH=

HOSTED_S3_ENDPOINT=
HOSTED_S3_ACCESS_KEY_ID=
HOSTED_S3_SECRET_ACCESS_KEY=
HOSTED_S3_BUCKET=

STORAGE_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
STORAGE_S3_REGION=ap-guangzhou
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=
STORAGE_S3_PUBLIC_HOST=

# 可选 Stripe 价格 / 统计；NEXT_PUBLIC_* 全部会暴露给浏览器。
NEXT_PUBLIC_OPENPANEL_API_URL=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_OPENPANEL_CLIENT_SECRET=
NEXT_PUBLIC_OPENPANEL_INTL_API_URL=
NEXT_PUBLIC_OPENPANEL_INTL_CLIENT_ID=
NEXT_PUBLIC_OPENPANEL_INTL_CLIENT_SECRET=
NEXT_PUBLIC_SHOW_DEV_API_ENV=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STRIPE_LIVE_PLUS_MONTHLY=
NEXT_PUBLIC_STRIPE_LIVE_PLUS_YEARLY=
NEXT_PUBLIC_STRIPE_LIVE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_LIVE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_LIVE_ULTRA_MONTHLY=
NEXT_PUBLIC_STRIPE_LIVE_ULTRA_YEARLY=
NEXT_PUBLIC_STRIPE_SANDBOX_PLUS_MONTHLY=
NEXT_PUBLIC_STRIPE_SANDBOX_PLUS_YEARLY=
NEXT_PUBLIC_STRIPE_SANDBOX_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_SANDBOX_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_SANDBOX_ULTRA_MONTHLY=
NEXT_PUBLIC_STRIPE_SANDBOX_ULTRA_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_YEARLY=
