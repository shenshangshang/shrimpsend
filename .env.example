# Docker Compose 服务端环境变量（复制为仓库根目录 .env）
# start-dev.sh / deploy.sh 会把这些值注入 mysql / wukongim / backend 容器。

MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=ultrasend
MYSQL_PASSWORD=changeme

REALTIME_BUS=wukongim
WUKONGIM_IMAGE=registry.cn-shanghai.aliyuncs.com/wukongim/wukongim:v2
WUKONGIM_EXTERNAL_IP=127.0.0.1
WUKONGIM_WS_PUBLIC_URL=ws://127.0.0.1:5200
WUKONGIM_MANAGER_TOKEN=dev-wukongim-manager-token
WUKONGIM_WEBHOOK_HTTPADDR=http://backend:9000/api/wukongim/webhook
