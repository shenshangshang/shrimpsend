# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
COPY docs/ /app/docs/
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_ADMIN_EMAILS
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_OPENPANEL_API_URL
ARG NEXT_PUBLIC_OPENPANEL_CLIENT_ID
ARG NEXT_PUBLIC_OPENPANEL_CLIENT_SECRET
ARG NEXT_PUBLIC_OPENPANEL_INTL_API_URL
ARG NEXT_PUBLIC_OPENPANEL_INTL_CLIENT_ID
ARG NEXT_PUBLIC_OPENPANEL_INTL_CLIENT_SECRET
ARG NEXT_PUBLIC_OPENPANEL_WEB_CLUSTER
ARG NEXT_PUBLIC_SHOW_DEV_API_ENV
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_STRIPE_BILLING
ARG NEXT_PUBLIC_STRIPE_LIVE_PLUS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LIVE_PLUS_YEARLY
ARG NEXT_PUBLIC_STRIPE_LIVE_PRO_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LIVE_PRO_YEARLY
ARG NEXT_PUBLIC_STRIPE_LIVE_ULTRA_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LIVE_ULTRA_YEARLY
ARG NEXT_PUBLIC_STRIPE_SANDBOX_PLUS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_SANDBOX_PLUS_YEARLY
ARG NEXT_PUBLIC_STRIPE_SANDBOX_PRO_MONTHLY
ARG NEXT_PUBLIC_STRIPE_SANDBOX_PRO_YEARLY
ARG NEXT_PUBLIC_STRIPE_SANDBOX_ULTRA_MONTHLY
ARG NEXT_PUBLIC_STRIPE_SANDBOX_ULTRA_YEARLY
ARG NEXT_PUBLIC_WEB_BASE_URL
ARG NEXT_PUBLIC_WUKONGIM_WS_URL
RUN npm run build

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app/web
COPY --from=build --chown=node:node /app/web/.next/standalone /app/
COPY --from=build --chown=node:node /app/web/.next/static /app/web/.next/static
COPY --from=build --chown=node:node /app/web/public /app/web/public
COPY --from=build --chown=node:node /app/docs /app/docs
USER node
EXPOSE 3000
CMD ["node", "server.js"]
